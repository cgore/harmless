;;; harmless-complete-tests.el --- Tests for completion at point -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'harmless-complete)
(require 'harmless-session)

(cl-defstruct (harmless-complete-fake
               (:include harmless-provider)
               (:constructor harmless-complete-make-fake))
  script)

(defvar harmless-complete-test-calls nil
  "Calls recorded by `harmless-complete-fake'.")

(cl-defmethod harmless-provider-complete ((provider harmless-complete-fake)
                                          messages tools callback)
  (push (list provider messages tools) harmless-complete-test-calls)
  (when (functionp (harmless-complete-fake-script provider))
    (funcall (harmless-complete-fake-script provider)
             provider messages tools callback))
  nil)

(defun harmless-complete-test-bytes (path)
  "Return the raw bytes of PATH."
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally path)
    (buffer-string)))

(defun harmless-complete-test-cleanup (dir bufs)
  "Turn completion off, kill BUFS, and delete DIR."
  (when (fboundp 'harmless-complete)
    (harmless-complete -1))
  (dolist (buf bufs)
    (when (buffer-live-p buf)
      (with-current-buffer buf
        (setq buffer-read-only nil)
        (let ((inhibit-read-only t)
              (kill-buffer-query-functions nil)
              (kill-buffer-hook nil))
          (set-buffer-modified-p nil)
          (ignore-errors (set-visited-file-name nil t))
          (ignore-errors (kill-buffer buf))))))
  (dolist (buf (buffer-list))
    (when (and (buffer-live-p buf) (not (minibufferp buf)))
      (let ((file (buffer-file-name buf))
            (def (buffer-local-value 'default-directory buf)))
        (when (or (and (stringp file) (file-in-directory-p file dir))
                  (and (stringp def)
                       (file-in-directory-p def dir)
                       (string-prefix-p " " (buffer-name buf))))
          (with-current-buffer buf
            (setq buffer-read-only nil)
            (let ((inhibit-read-only t)
                  (kill-buffer-query-functions nil)
                  (kill-buffer-hook nil))
              (set-buffer-modified-p nil)
              (ignore-errors (set-visited-file-name nil t))
              (ignore-errors (kill-buffer buf))))))))
  (when (> (count-windows) 1)
    (delete-other-windows))
  (when (and (stringp dir) (file-directory-p dir))
    (ignore-errors (delete-directory dir t))))

(defmacro harmless-complete-test-with (text &rest body)
  "Visit a temp file TEXT and run BODY.
BODY sees `dir', `buf', `path', `bytes', `provider', and `bufs'.
State is written under `dir', not at /."
  (declare (indent 1))
  `(let* ((dir (make-temp-file "harmless-complete-" t))
          (path (expand-file-name "a.el" dir))
          (buf nil)
          (bufs nil)
          (provider (harmless-complete-make-fake
                     :name "fake" :host "none" :script nil))
          (harmless-directory (expand-file-name ".harmless" dir))
          (harmless--sessions (make-hash-table :test 'equal))
          (harmless--config-loaded t)
          (harmless-providers (list provider))
          (harmless-complete-test-calls nil)
          (project-find-functions nil)
          (bytes nil))
     (harmless-complete -1)
     (unwind-protect
         (progn
           (let ((coding-system-for-write 'utf-8-unix))
             (write-region ,text nil path nil 'silent))
           (setq buf (find-file-noselect path))
           (push buf bufs)
           (switch-to-buffer buf)
           (with-current-buffer buf
             (setq-local require-final-newline nil)
             (setq default-directory dir)
             (set-buffer-modified-p nil))
           (setq bytes (harmless-complete-test-bytes path))
           ,@body)
       (harmless-complete-test-cleanup dir bufs))))

(defun harmless-complete-test-reply (provider text)
  "Make PROVIDER answer with TEXT, which may be nil."
  (setf (harmless-complete-fake-script provider)
        (lambda (_provider _messages _tools callback)
          (funcall callback (list :text text))
          (funcall callback '(:stop "stop")))))

(defun harmless-complete-test-message ()
  "Return the latest completion request text."
  (plist-get (car (nth 1 (car harmless-complete-test-calls))) :content))

(defmacro harmless-complete-test-signal (form)
  "Return the error message signaled by FORM."
  `(error-message-string (should-error ,form :type 'error)))

(ert-deftest harmless-complete-is-off ()
  (should (commandp 'harmless-complete))
  (should (commandp 'harmless-complete-at-point))
  (should (commandp 'harmless-complete-accept))
  (should-not (lookup-key harmless-complete-map (kbd "TAB")))
  (should-not (keymapp (lookup-key harmless-complete-map (kbd "C-c"))))
  (harmless-complete-test-with
      "abc"
    (with-current-buffer buf
      (local-set-key (kbd "C-c C-c") #'ignore)
      (harmless-complete 1)
      (should (eq 'ignore (key-binding (kbd "C-c C-c"))))
      (should (eq 'indent-for-tab-command (key-binding (kbd "TAB"))))
      (harmless-complete -1)
      (should-not harmless-complete)
      (should-not (memq #'harmless-complete--post-command
                        post-command-hook))
      (setq harmless-complete-test-calls nil)
      (harmless-complete-at-point)
      (should-not harmless-complete-test-calls)
      (should-not harmless-complete--overlay)
      (should (eq 'indent-for-tab-command (key-binding (kbd "TAB"))))
      (goto-char (point-max))
      (execute-kbd-macro (kbd "z"))
      (should-not harmless-complete-test-calls)
      (should (equal "abcz" (buffer-string)))
      (should-not harmless-complete--overlay))
    (should (equal bytes (harmless-complete-test-bytes path)))))

(ert-deftest harmless-complete-shows-an-overlay ()
  (harmless-complete-test-with
      "abc"
    (setf (harmless-complete-fake-script provider)
          (lambda (_provider _messages _tools callback)
            (funcall callback '(:text "NE"))
            (funcall callback '(:text "W"))
            (funcall callback '(:stop "stop"))))
    (with-current-buffer buf
      (goto-char (point-max))
      (let ((pt (point)))
        (harmless-complete 1)
        (setq harmless-complete-test-calls nil)
        (harmless-complete-at-point)
        (should (= 1 (length harmless-complete-test-calls)))
        (should (equal "abc<point>" (harmless-complete-test-message)))
        (should (eq nil (nth 2 (car harmless-complete-test-calls))))
        (should harmless-complete--overlay)
        (should (equal "NEW" (overlay-get harmless-complete--overlay
                                          'harmless-complete-text)))
        (should (equal "abc" (buffer-string)))
        (should (= pt (point)))
        (should-not (buffer-modified-p))
        (should (eq 'harmless-complete-accept (key-binding (kbd "TAB"))))
        (harmless-complete -1)
        (should-not harmless-complete--overlay)
        (should (equal "abc" (buffer-string)))
        (should-not (buffer-modified-p))))
    (should (equal bytes (harmless-complete-test-bytes path)))))

(ert-deftest harmless-complete-accepts-with-tab ()
  (harmless-complete-test-with
      "xxOLDyy"
    (harmless-complete-test-reply provider "NEW")
    (with-current-buffer buf
      (goto-char 3)
      (harmless-complete 1)
      (harmless-complete-at-point)
      (should (equal "xxOLDyy" (buffer-string)))
      (execute-kbd-macro (kbd "TAB"))
      (should (equal "xxNEWOLDyy" (buffer-string)))
      (should (= 6 (point)))
      (should (buffer-modified-p))
      (should-not harmless-complete--overlay)
      (setq buffer-undo-list (primitive-undo 1 buffer-undo-list))
      (should (equal "xxOLDyy" (buffer-string))))
    (should (equal bytes (harmless-complete-test-bytes path)))
    (harmless-complete-test-reply provider " ")
    (with-current-buffer buf
      (erase-buffer)
      (insert "ab")
      (goto-char (point-max))
      (set-buffer-modified-p nil)
      (harmless-complete 1)
      (harmless-complete-at-point)
      (should (equal " " (overlay-get harmless-complete--overlay
                                      'harmless-complete-text)))
      (harmless-complete-accept)
      (should (equal "ab " (buffer-string)))
      (should-not harmless-complete--overlay))
    (should (equal bytes (harmless-complete-test-bytes path)))))

(ert-deftest harmless-complete-dismisses-on-another-key ()
  (harmless-complete-test-with
      "abcd"
    (let ((calls 0))
      (setf (harmless-complete-fake-script provider)
            (lambda (_provider _messages _tools callback)
              (setq calls (1+ calls))
              (funcall callback (list :text (if (= calls 1) "NEW" "")))
              (funcall callback '(:stop "stop"))))
      (with-current-buffer buf
        (goto-char 2)
        (harmless-complete 1)
        (setq harmless-complete-test-calls nil)
        (harmless-complete-at-point)
        (should harmless-complete--overlay)
        (execute-kbd-macro (kbd "C-f"))
        (should-not harmless-complete--overlay)
        (should (equal "abcd" (buffer-string)))
        (should (= 3 (point)))
        (should (= 1 calls))
        (goto-char (point-max))
        (execute-kbd-macro (kbd "z"))
        (should (equal "abcdz" (buffer-string)))
        (should-not (string-search "NEW" (buffer-string)))
        (should-not harmless-complete--overlay)
        (should (= 2 calls))
        (should (string-search "abcdz<point>"
                               (harmless-complete-test-message)))))
    (should (equal bytes (harmless-complete-test-bytes path)))))

(ert-deftest harmless-complete-shows-nothing-for-a-skipped-buffer ()
  (harmless-complete-test-with
      "abc"
    (harmless-complete-test-reply provider "NEW")
    (let ((hidden (get-buffer-create " *harmless-complete*"))
          (notes (get-buffer-create "harmless-complete-notes")))
      (push hidden bufs)
      (push notes bufs)
      (unwind-protect
          (progn
            (with-current-buffer buf
              (harmless-complete 1)
              (setq buffer-read-only t)
              (setq harmless-complete-test-calls nil)
              (harmless-complete-at-point)
              (should-not harmless-complete-test-calls)
              (should-not harmless-complete--overlay)
              (should (equal "abc" (buffer-string)))
              (setq buffer-read-only nil)
              (harmless-complete-at-point)
              (should harmless-complete--overlay)
              (setq buffer-read-only t)
              (should (equal "buffer is read-only"
                             (harmless-complete-test-signal
                               (execute-kbd-macro (kbd "TAB")))))
              (should (equal "abc" (buffer-string)))
              (should-not harmless-complete--overlay)
              (setq buffer-read-only nil))
            (with-current-buffer hidden
              (insert "secret")
              (goto-char (point-max))
              (setq harmless-complete-test-calls nil)
              (harmless-complete 1)
              (harmless-complete-at-point)
              (should-not harmless-complete-test-calls)
              (should-not harmless-complete--overlay)
              (should (equal "secret" (buffer-string))))
            (with-current-buffer (window-buffer (minibuffer-window))
              (let ((buffer-read-only nil))
                (should (minibufferp))
                (setq harmless-complete-test-calls nil)
                (harmless-complete 1)
                (harmless-complete-at-point)
                (should-not harmless-complete-test-calls)
                (should-not harmless-complete--overlay)))
            (with-current-buffer notes
              (insert "seen")
              (setq default-directory dir)
              (harmless-complete 1)
              (setq harmless-complete-test-calls nil)
              (harmless-complete-at-point)
              (should (equal "seen<point>"
                             (harmless-complete-test-message)))
              (should harmless-complete--overlay)
              (should (equal "seen" (buffer-string)))))
        (harmless-complete -1)))))

(ert-deftest harmless-complete-inserts-nothing-for-an-empty-reply ()
  (harmless-complete-test-with
      "abc"
    (dolist (reply '(nil ""))
      (harmless-complete-test-reply provider reply)
      (with-current-buffer buf
        (goto-char (point-max))
        (harmless-complete 1)
        (setq harmless-complete-test-calls nil)
        (harmless-complete-at-point)
        (should harmless-complete-test-calls)
        (should-not harmless-complete--overlay)
        (should (equal "abc" (buffer-string)))
        (should-not (buffer-modified-p))))
    (setf (harmless-complete-fake-script provider)
          (lambda (_provider _messages _tools callback)
            (funcall callback '(:stop "stop"))))
    (with-current-buffer buf
      (harmless-complete 1)
      (harmless-complete-at-point)
      (should-not harmless-complete--overlay)
      (should (equal "abc" (buffer-string))))
    (setf (harmless-complete-fake-script provider)
          (lambda (_provider _messages _tools callback)
            (funcall callback '(:error "nope"))))
    (with-current-buffer buf
      (harmless-complete 1)
      (harmless-complete-at-point)
      (should-not harmless-complete--overlay)
      (should (equal "abc" (buffer-string))))
    (let ((dying (get-buffer-create "harmless-complete-dying")))
      (push dying bufs)
      (with-current-buffer dying
        (insert "abc")
        (setq default-directory dir)
        (setf (harmless-complete-fake-script provider)
              (lambda (_provider _messages _tools callback)
                (kill-buffer dying)
                (funcall callback '(:text "NEW"))
                (funcall callback '(:stop "stop"))))
        (harmless-complete 1)
        (harmless-complete-at-point)
        (should-not (buffer-live-p dying))
        (should-not harmless-complete--overlay)))
    (should (equal bytes (harmless-complete-test-bytes path)))))

(ert-deftest harmless-complete-sends-the-text-around-point ()
  (harmless-complete-test-with
      "0123456789"
    (let ((tools-called nil)
          (other (harmless-complete-make-fake
                  :name "other" :host "none" :script nil))
          (session nil))
      (setf (harmless-complete-fake-script provider)
            (lambda (_provider _messages _tools callback)
              (funcall callback '(:tool-call "id" "harmless-tool-read-file" "{}"))
              (funcall callback '(:text "NEW"))
              (funcall callback '(:stop "stop"))))
      (cl-letf (((symbol-function 'harmless-tool-call)
                 (lambda (&rest _) (setq tools-called t)))
                ((symbol-function 'harmless-turn-run)
                 (lambda (&rest _) (error "sent the transcript"))))
        (with-current-buffer buf
          (goto-char 6)
          (harmless-complete 1)
          (let ((harmless-read-file-max-bytes 4))
            (setq harmless-complete-test-calls nil)
            (harmless-complete-at-point)
            (should (equal "34<point>56" (harmless-complete-test-message)))
            (should (eq nil (nth 2 (car harmless-complete-test-calls))))
            (should-not tools-called)
            (should (equal "NEW"
                           (overlay-get harmless-complete--overlay
                                       'harmless-complete-text)))
            (should (equal "0123456789" (buffer-string))))
          (let ((harmless-read-file-max-bytes 10))
            (goto-char (point-max))
            (setq harmless-complete-test-calls nil)
            (harmless-complete-at-point)
            (should (equal "0123456789<point>"
                           (harmless-complete-test-message))))
          (let ((harmless-read-file-max-bytes 0))
            (setq harmless-complete-test-calls nil)
            (harmless-complete-at-point)
            (should (equal "<point>" (harmless-complete-test-message))))
          (erase-buffer)
          (insert "AAA\nBODY\nZZZ")
          (goto-char (point-min))
          (forward-line 1)
          (let ((beg (point)))
            (goto-char (line-end-position))
            (narrow-to-region beg (point))
            (goto-char (+ (point-min) 2))
            (setq harmless-complete-test-calls nil)
            (harmless-complete-at-point)
            (should (equal "BO<point>DY" (harmless-complete-test-message)))
            (should-not (string-search "AAA" (harmless-complete-test-message)))
            (should-not (string-search "ZZZ" (harmless-complete-test-message))))
          (widen)
          (dolist (sample '("" "/" "c:/" "c:\\" "sub/" "  "))
            (erase-buffer)
            (insert sample)
            (goto-char (point-max))
            (setq harmless-complete-test-calls nil)
            (harmless-complete-at-point)
            (should (equal (concat sample "<point>")
                           (harmless-complete-test-message))))
          (erase-buffer)
          (insert "0123456789")
          (set-buffer-modified-p nil))
        (setq harmless-providers (list other provider))
        (setq session (harmless-session-new
                       :cwd dir :provider provider :model "m"))
        (harmless-session-append-user session "SECRET-TRANSCRIPT")
        (with-current-buffer buf
          (setq default-directory dir)
          (erase-buffer)
          (insert "abc")
          (goto-char (point-max))
          (harmless-complete 1)
          (setq harmless-complete-test-calls nil)
          (harmless-complete-at-point)
          (should (eq provider (car (car harmless-complete-test-calls))))
          (should-not (string-search "SECRET-TRANSCRIPT"
                                     (harmless-complete-test-message)))
          (should (equal "abc<point>" (harmless-complete-test-message)))
          (should (equal "SECRET-TRANSCRIPT"
                         (plist-get (car (harmless-session-messages session))
                                    :content)))
          (should (eq 'idle (harmless-session-status session)))
          (should (= 1 (hash-table-count harmless--sessions)))
          (should-not tools-called))
        (setq harmless-providers nil)
        (setq harmless--sessions (make-hash-table :test 'equal))
        (with-current-buffer buf
          (setq harmless-complete-test-calls nil)
          (harmless-complete 1)
          (harmless-complete-at-point)
          (should-not harmless-complete-test-calls)
          (should-not harmless-complete--overlay)
          (should (equal "abc" (buffer-string))))))
    (should (equal "0123456789" (harmless-complete-test-bytes path)))))

(provide 'harmless-complete-tests)
